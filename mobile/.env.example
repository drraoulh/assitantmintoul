# Optional. The app also auto-detects the Expo LAN IP.
# Use this when auto-detection is wrong.
# Never point the phone at Ollama (port 11434). Always use FastAPI (port 8000).
#
# Production / jury (Render API):
# EXPO_PUBLIC_API_URL=https://cameroon-ai-tour-guide-api.onrender.com
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Physical phone on the same Wi-Fi (replace with YOUR PC address):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
#
# Web / Windows desktop:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

EXPO_PUBLIC_API_URL=https://cameroon-ai-tour-guide-api.onrender.com
