# Copy this file to .env in the project root AND to backend/.env
#   copy .env.example .env
#   copy .env.example backend\.env

# --- API ---
APP_NAME=Cameroon AI Tour Guide
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins. Use * only in local development.
CORS_ORIGINS=*

# --- PostgreSQL / Supabase (conversation history) ---
# Local Docker Postgres (used by docker-compose).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cameroon_tour_guide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cameroon_tour_guide

# Supabase: Project Settings > Database > Connection string > URI, then replace
# "postgresql://" with "postgresql+asyncpg://" and paste your password.
#   Direct (port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#   Pooler (port 6543, IPv4-friendly; prepared statements are disabled automatically):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# false = history in memory (lost on restart). true = persisted, tables created on boot.
DATABASE_ENABLED=false
DATABASE_ECHO=false
# Turns replayed to the model as context (the full thread stays in the database).
CONVERSATION_CONTEXT_MESSAGES=16

# --- LLM (Hugging Face first) ---
# Routes never talk to providers directly. FastAPI uses AIService.
# LLM_PROVIDER: huggingface | ollama | placeholder
LLM_PROVIDER=huggingface

# Chat model on Hugging Face Inference Providers (OpenAI-compatible router).
# Prefer a mid-size instruct model with :fastest routing for lower latency.
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct:fastest
HF_API_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_SECONDS=60

# Answer length budgets. Shorter = faster replies (and faster TTS in voice mode).
LLM_MAX_TOKENS=380
LLM_VOICE_MAX_TOKENS=160
LLM_HISTORY_MESSAGES=8
LLM_VOICE_HISTORY_MESSAGES=4

# Required for Hugging Face Inference Providers.
# Create a token with "Inference Providers" permission:
# https://huggingface.co/settings/tokens
# Also enable at least one provider:
# https://huggingface.co/settings/inference-providers
HUGGINGFACE_HUB_TOKEN=

# Optional alias accepted by the app:
# HF_TOKEN=

# Legacy / optional local Ollama fallback
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Other HF model ids
HF_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_VISION_MODEL_ID=openai/clip-vit-base-patch32
HF_WHISPER_MODEL_ID=openai/whisper-large-v3-turbo
HF_TTS_MODEL_ID=s2.1-pro-free

# --- Local tourism knowledge base (RAG) ---
# Lexical retrieval over data/tourist_sites and data/documents.
RAG_ENABLED=true
RAG_TOP_K=4
# Leave empty to use the repo data/ folder automatically.
RAG_DATA_DIR=

# --- Live open-web search (organic first; wiki only if needed) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
# Web search is skipped when the local KB already covers the question.
# Otherwise it is time-boxed; the answer continues without it on timeout.
WEB_SEARCH_TIMEOUT_SECONDS=4
VOICE_WEB_SEARCH_TIMEOUT_SECONDS=2.5

# --- Speech STT ---
# whisper (local faster-whisper) | huggingface (cloud Whisper) | placeholder
SPEECH_PROVIDER=huggingface
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference
HF_SPEECH_TIMEOUT_SECONDS=120

# --- TTS: fish (Fish Audio) | none (mobile uses expo-speech) ---
TTS_PROVIDER=fish
# https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_TIMEOUT_SECONDS=90

# --- Vision: gemini | placeholder ---
VISION_PROVIDER=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90
