# Copy this file to .env in the project root AND to backend/.env
#   copy .env.example .env
#   copy .env.example backend\.env

# --- API ---
APP_NAME=Cameroon AI Tour Guide
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins. Use * only in local development.
CORS_ORIGINS=*

# --- PostgreSQL ---
# Used by docker-compose and by the FastAPI app (SQLAlchemy async URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cameroon_tour_guide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cameroon_tour_guide

# Chat works without PostgreSQL. Set true only if Docker Postgres is running.
DATABASE_ENABLED=false

# --- LLM ---
# Routes never talk to Ollama directly. FastAPI uses AIService.
# LLM_PROVIDER: ollama | placeholder | huggingface
LLM_PROVIDER=ollama

# Default is qwen3:4b (fits a 16 GB CPU laptop).
# Quality upgrade on a stronger machine: LLM_MODEL=qwen3:8b
LLM_MODEL=qwen3:4b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Hugging Face (not wired yet — no paid API required)
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_VISION_MODEL_ID=openai/clip-vit-base-patch32
HF_WHISPER_MODEL_ID=openai/whisper-small
HF_TTS_MODEL_ID=piper

# Never commit real tokens. Leave empty unless a later phase needs Hub access.
HUGGINGFACE_HUB_TOKEN=
