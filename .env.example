# Copy this file to .env in the project root AND to backend/.env
#   copy .env.example .env
#   copy .env.example backend\.env

# --- API ---
APP_NAME=Cameroon AI Tour Guide
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins. Use * only in local development.
CORS_ORIGINS=*

# --- PostgreSQL ---
# Used by docker-compose and by the FastAPI app (SQLAlchemy async URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cameroon_tour_guide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cameroon_tour_guide

# Chat works without PostgreSQL. Set true only if Docker Postgres is running.
DATABASE_ENABLED=false

# --- LLM (Hugging Face first) ---
# Routes never talk to providers directly. FastAPI uses AIService.
# LLM_PROVIDER: huggingface | ollama | placeholder
LLM_PROVIDER=huggingface

# Chat model on Hugging Face Inference Providers (OpenAI-compatible router).
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_API_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_SECONDS=120

# Required for Hugging Face Inference Providers.
# Create a token with "Inference Providers" permission:
# https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=

# Optional alias accepted by the app:
# HF_TOKEN=

# Legacy / optional local Ollama fallback
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Other HF model ids reserved for later modalities
HF_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_VISION_MODEL_ID=openai/clip-vit-base-patch32
HF_WHISPER_MODEL_ID=openai/whisper-small
HF_TTS_MODEL_ID=piper

# --- Local tourism knowledge base (RAG) ---
# Lexical retrieval over data/tourist_sites and data/documents.
RAG_ENABLED=true
RAG_TOP_K=6
# Leave empty to use the repo data/ folder automatically.
RAG_DATA_DIR=

# --- Live web search (Wikipedia + DuckDuckGo) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4

# --- Firebase / Firestore (cloud knowledge base) ---
# Keep false until you create a Firebase project and service account.
# Local data/ files remain the seed source; seed with:
#   cd backend && python -m app.services.firebase.cli_seed
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to the Firebase service account JSON (never commit this file)
FIREBASE_CREDENTIALS_FILE=
